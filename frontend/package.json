{
  "name": "tradewind-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "npm run typecheck && vite build --mode desktop",
    "typecheck": "tsc --noEmit",
    "build:check": "npm run typecheck && vite build",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:backend": "powershell -ExecutionPolicy Bypass -File ../scripts/build-desktop-backend.ps1",
    "desktop:build": "tauri build",
    "desktop:build:full": "npm run desktop:backend && tauri build"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
